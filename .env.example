# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tbb_jacarei
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
# Obrigatório, mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Origens liberadas no CORS (separe várias por vírgula). Na porta 80 o navegador envia "http://localhost", sem ":80"
FRONTEND_URL=http://localhost

# Primeiro admin (criado pelo seed só se ainda não existir nenhum admin).
# Preencha antes de subir; senha com 8+ caracteres. Vazio = nenhum admin criado.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# Frontend
FRONTEND_PORT=80
# Origem do backend, sem /api
VITE_API_URL=http://localhost:3000

# Database URL (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tbb_jacarei

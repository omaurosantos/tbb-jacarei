# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tbb_jacarei
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
# Origens liberadas no CORS (separe várias por vírgula). Na porta 80 o navegador envia "http://localhost", sem ":80"
FRONTEND_URL=http://localhost

# Primeiro admin (criado pelo seed só se ainda não existir nenhum admin)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador

# Frontend
FRONTEND_PORT=80
# Origem do backend, sem /api
VITE_API_URL=http://localhost:3000

# Database URL (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tbb_jacarei

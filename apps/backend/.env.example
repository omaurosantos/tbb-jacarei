# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tbb_jacarei?schema=public"

# JWT (em produção: mínimo 32 caracteres, nunca o valor de exemplo; gere com: openssl rand -base64 48)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (origens liberadas; separe várias por vírgula)
FRONTEND_URL=http://localhost:8080

# Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

